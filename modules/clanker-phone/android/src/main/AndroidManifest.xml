<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets listApps see every app with a launcher icon, without QUERY_ALL_PACKAGES. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
      android:name="expo.modules.clankerphone.PhoneService"
      android:label="@string/clanker_phone_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/clanker_accessibility" />
    </service>
  </application>
</manifest>
